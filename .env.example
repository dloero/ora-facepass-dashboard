# Apollo.io API
APOLLO_API_KEY=your_apollo_api_key_here

# Slack
# Incoming Webhook URL for the channel where Dereck should receive the report
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
# Optional: Slack user ID to @mention in the message (e.g. U0123ABCDEF)
SLACK_DERECK_USER_ID=

# Lead aging threshold (days with no activity before flagging)
LEAD_AGING_THRESHOLD_DAYS=3

# Days idle before a lead is flagged for reassignment instead of call/email (default: 30)
LEAD_REASSIGNMENT_THRESHOLD_DAYS=30

# Apollo.io label or list name that identifies Ora FacePass leads.
# Leave blank (recommended) to scan all contacts in the account.
# NOTE: contacts must have this label applied in Apollo for filtering to work.
APOLLO_LEAD_LABEL=

# Stop paginating once all contacts on a page are older than this many days (default: 60)
# Keeps runtime fast on accounts with 98K+ contacts.
LEAD_EARLY_STOP_DAYS=60

# Hard cap on pages fetched per run — 20 pages = up to 2,000 contacts (default: 20)
LEAD_MAX_PAGES=20

# ─── Demo Follow-Up Drafter ───────────────────────────────────────────────────

# GoHighLevel (GHL) API key — generate under Settings > Integrations > API Key
GHL_API_KEY=your_ghl_api_key_here

# GHL Location ID — found in Settings > Business Profile or in the URL (?locationId=...)
GHL_LOCATION_ID=your_ghl_location_id_here

# Optional: restrict to a specific GHL calendar ID (leave blank to scan all calendars)
GHL_CALENDAR_ID=

# Calendly booking link included in every follow-up email draft
CALENDLY_LINK=https://calendly.com/orafacepass

# ─── Gmail Draft Creation (optional) ─────────────────────────────────────────
# When set, the script creates a real Gmail draft for each completed demo so
# Dereck can review and send with one click from Gmail Drafts.
# If these are not set, the script runs in Slack-only mode.
#
# How to get these values:
#   1. Go to console.cloud.google.com → APIs & Services → Credentials
#   2. Create an OAuth 2.0 Client ID (Desktop app)
#   3. Enable the Gmail API for the project
#   4. Run the one-time consent flow to obtain the refresh token
#      (e.g. using oauth2l or the Google OAuth Playground at oauth2.googleusercontent.com)
#   5. Paste the values below
GMAIL_CLIENT_ID=your_gmail_client_id.apps.googleusercontent.com
GMAIL_CLIENT_SECRET=your_gmail_client_secret
GMAIL_REFRESH_TOKEN=your_gmail_refresh_token
# The "From" address that appears on drafts (should match the Google account above)
GMAIL_FROM_EMAIL=dereck@orafacepass.com
